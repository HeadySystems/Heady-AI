CLOUD_HEADYCONNECTION_URL=https://heady-manager-headyconnection.headysystems.com

# ═══════════════════════════════════════════════════════════════════
# §17 — Port Allocation (Sacred Geometry v4.0)
# ═══════════════════════════════════════════════════════════════════
PORT_MANAGER=3301
PORT_GUARD=3302
PORT_INFER=3303
PORT_EMBED=3304
PORT_EVAL=3305
PORT_CACHE=3306
PORT_MCP=3307
PORT_EDGE=3308
PORT_DASHBOARD=3309
PORT_GATEWAY=3310
PORT_CHAIN=3311
PORT_SITE=3312

# ═══════════════════════════════════════════════════════════════════
# §18 — GitHub Remotes
# ═══════════════════════════════════════════════════════════════════
GIT_REMOTE_HC=hc-main
GIT_REMOTE_HS=hs-main
GIT_REMOTE_HAI=headyai
GIT_REMOTE_AZURE=azure-main

# ═══════════════════════════════════════════════════════════════════
# §19 — Colab Pro+ Runtimes
# ═══════════════════════════════════════════════════════════════════
COLAB_PRO_TOKEN=
COLAB_RUNTIME_1_URL=  # Vector Brain
COLAB_RUNTIME_2_URL=  # Model Forge
COLAB_RUNTIME_3_URL=  # Orchestrator Edge
COLAB_RUNTIME_4_URL=  # Learning Engine

# ═══════════════════════════════════════════════════════════════════
# §20 — Feature Flags & AI Node Toggles
# ═══════════════════════════════════════════════════════════════════
ENABLE_ATLAS=false
ENABLE_BUILDER=false
ENABLE_CODEMAP=false
ENABLE_JULES=false
ENABLE_OBSERVER=true
ENABLE_PERPLEXITY=false
ENABLE_PQC=false
ENABLE_SYNC_SERVICE=true
JULES_ENABLED=true
OBSERVER_ENABLED=true
HEADY_POSTGRES_ENABLED=false
HEADY_REDIS_ENABLED=false

# ═══════════════════════════════════════════════════════════════════
# §21 — Persistence System (v4.1.0+)
# ═══════════════════════════════════════════════════════════════════
HEADY_PERSISTENCE_DB_URL=postgresql://user:pass@host:5432/heady_persistence
HEADY_PERSISTENCE_REDIS_URL=
HEADY_SYNC_WS_URL=wss://sync.headysystems.com

# ═══════════════════════════════════════════════════════════════════
# §22 — HeadyBuddy Service
# ═══════════════════════════════════════════════════════════════════
BUDDY_SERVICE_PORT=3310
BUDDY_WS_PORT=3311
BUDDY_MEMORY_DB_URL=postgresql://user:pass@host:5432/heady_buddy
BUDDY_PERSONALITY=professional
BUDDY_DEFAULT_PERMISSION=suggest
BUDDY_PROACTIVITY=0.618
BUDDY_ENCRYPTION_KEY=
BUDDY_SESSION_SECRET=

# ═══════════════════════════════════════════════════════════════════
# §23 — HeadyAI-IDE Service
# ═══════════════════════════════════════════════════════════════════
IDE_SERVICE_PORT=3320
IDE_WORKSPACE_ROOT=/workspace
IDE_CLOUD_COMPUTE_URL=https://compute.headysystems.com
IDE_MCP_GATEWAY_URL=https://mcp.headymcp.com
IDE_ARTIFACT_STORE_URL=https://artifacts.headysystems.com

# ═══════════════════════════════════════════════════════════════════
# §24 — Observability & Monitoring
# ═══════════════════════════════════════════════════════════════════
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ═══════════════════════════════════════════════════════════════════
# §25 — Cross-Service Auth Relay
# ═══════════════════════════════════════════════════════════════════
AUTH_RELAY_ALLOWED_DOMAINS=headyme.com,headysystems.com,headyconnection.org,headybuddy.org,headymcp.com,headyio.com,headybot.com,headyapi.com,headyai.com
AUTH_RELAY_ORIGIN=https://auth.headysystems.com

# ═══════════════════════════════════════════════════════════════════
# §26 — Budget / Cost Controls
# ═══════════════════════════════════════════════════════════════════
# Set monthly AI spend limits (USD)
MONTHLY_AI_BUDGET_USD=500
MONTHLY_COMPUTE_BUDGET_USD=200

# ═══════════════════════════════════════════════════════════════════
# §27 — HeadyWeb Browser
# ═══════════════════════════════════════════════════════════════════
HEADYWEB_PORT=3300
HEADYWEB_AI_SEARCH_URL=https://api.headyai.com/search
HEADYWEB_EXTENSION_REGISTRY_URL=https://extensions.headysystems.com
HEADYWEB_TAB_SYNC_WS=wss://tabs.headysystems.com
