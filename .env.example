# ══════════════════════════════════════════════════════════════════
# HEADY™ Environment Template — Copy to .env and fill in values
# NEVER commit the real .env file. This template is safe.
# ══════════════════════════════════════════════════════════════════

# ─── HEADY INTERNAL AUTH ─────────────────────────────────────────
HEADY_API_KEY=
ADMIN_TOKEN=
INTERNAL_NODE_SECRET=
VAULT_PASSPHRASE=

# ─── OWNER / FOUNDER GOVERNANCE (ADR-0013) ──────────────────────
HEADY_OWNER=
HEADY_OWNER_PASS=

# ─── NEON DATABASE (Scale Plan) ──────────────────────────────────
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
NEON_API_KEY=
NEON_PROJECT_ID=
NEON_SECRET=

# ─── UPSTASH REDIS (REST cache tier — URL + token only) ─────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── PERPLEXITY (Sonar Pro) ─────────────────────────────────────
PERPLEXITY_API_KEY=

# ─── SENTRY (Error Monitoring) ──────────────────────────────────
SENTRY_AUTH_TOKEN=
SENTRY_PERSONAL_TOKEN=
SENTRY_ORG=
SENTRY_DSN=
SENTRY_PROJECT=

# ─── GITHUB ─────────────────────────────────────────────────────
GITHUB_TOKEN=

# ─── HUGGING FACE (non-locked embed fallback — OFF by default) ──
HF_TOKEN=
HUGGINGFACE_TOKEN=
HEADY_ALLOW_HF_EMBED=

# ─── GROQ (Fast LLM) ───────────────────────────────────────────
GROQ_API_KEY=

# ─── CLOUDFLARE ─────────────────────────────────────────────────
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL=

# ─── CLAUDE / ANTHROPIC ────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_API_KEY2=
ANTHROPIC_API_KEY3=
ANTHROPIC_ORG_ID=

# ─── OPENAI ─────────────────────────────────────────────────────
OPENAI_API_KEY=

# ─── GOOGLE / GEMINI ────────────────────────────────────────────
GEMINI_API_KEY=
GOOGLE_API_KEY=
FIREBASE_API_KEY=

# ─── PINECONE (Vector DB) ──────────────────────────────────────
PINECONE_API_KEY=

# ─── STRIPE (Payments) ─────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=

# ─── 1PASSWORD (Service Account) ───────────────────────────────
OP_SERVICE_ACCOUNT_TOKEN=

# Device sync fabric credential — required for /ws/sync + platform-control tier (min 20 chars)
SYNC_TOKEN=
