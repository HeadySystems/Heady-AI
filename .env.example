# ╔══════════════════════════════════════════════════════════════════╗
# ║  HEADY™ Environment Template — secrets via secure injection only   ║
# ║  Copy to `.env` (gitignored) OR inject from GCP Secret Manager.    ║
# ║  Values marked [SECRET] must come from a secret store, never a     ║
# ║  committed literal. © 2026 HeadySystems Inc. — Eric Haywood        ║
# ╚══════════════════════════════════════════════════════════════════╝

# ── Sanctioned embedding binding (ADR-0015 locked model @cf/baai/bge-small-en-v1.5) ──
# This is the locked, off-platform serving path for `heady-embed` (tooling/embed-corpus).
# With both set, the corpus embedding workflow embeds via Cloudflare Workers AI — no third
# party, no IP transmitted off the sanctioned provider. Account id is non-secret; token is [SECRET].
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=                 # [SECRET] Workers AI token (scope: Workers AI:Read)

# Optional non-locked fallback. Embeds via Hugging Face (BAAI/bge-small-en-v1.5, same weights),
# but transmits corpus content to a third party — OFF by default; requires `--allow-hf` to use.
# HUGGINGFACE_TOKEN=                  # [SECRET]
# HEADY_ALLOW_HF_EMBED=0

# ── Retrieval authority (ADR-0003: Neon pgvector) ──
DATABASE_URL=                         # [SECRET] Neon Postgres connection string

# ── Cache / best-effort hot tier (Upstash Redis, namespaced tenant:{id}:*) ──
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=             # [SECRET]

# ── Inter-service trust + key vault ──
INTERNAL_NODE_SECRET=                 # [SECRET] inter-service auth
VAULT_PASSPHRASE=                     # [SECRET] API key encryption

# ── Model providers (AI Gateway chokepoint) ──
ANTHROPIC_API_KEY=                    # [SECRET]
GROQ_API_KEY=                         # [SECRET]
OPENAI_API_KEY=                       # [SECRET]
GEMINI_API_KEY=                       # [SECRET]
