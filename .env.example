# ╚══════════════════════════════════════════════════════════════════╝

# ═══════════════════════════════════════════════════════════════════
# §1 — Runtime & Identity
# ═══════════════════════════════════════════════════════════════════
NODE_ENV=production
HEADY_ENV=production
LOG_LEVEL=info
PORT=3301
HEADY_VERSION=5.0.0
HEADY_INSTANCE_ID=
HEADY_TARGET=cloud
HEADY_MODE=CLOUD_ONLY
HEADY_CLOUD_MODE=true
HEADY_LOCAL_SERVICES_ENABLED=false
HEADY_MANAGER_LOCAL=false
DISABLE_LOCALHOST=true

# ═══════════════════════════════════════════════════════════════════
# §2 — Database (Neon Postgres + pgvector)
# ═══════════════════════════════════════════════════════════════════
DATABASE_URL=postgresql://heady:YOUR_PASSWORD@ep-XXXXX.us-east-2.aws.neon.tech/neondb?sslmode=require
NEON_DATABASE_URL=postgresql://heady:YOUR_PASSWORD@ep-XXXXX.us-east-2.aws.neon.tech/neondb?sslmode=require
NEON_PROJECT_ID=
DB_HOST=ep-XXXXX.us-east-2.aws.neon.tech
DB_PORT=5432
DB_NAME=neondb
DB_USER=heady
DB_PASSWORD=
DB_SSL=true
PGVECTOR_DIMENSIONS=384

# ═══════════════════════════════════════════════════════════════════
# §3 — Cache (Upstash Redis — rediss:// required)
# ═══════════════════════════════════════════════════════════════════
REDIS_URL=rediss://default:YOUR_TOKEN@YOUR_HOST.upstash.io:6379
REDIS_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
UPSTASH_KAFKA_REST_URL=
UPSTASH_KAFKA_REST_TOKEN=

# ═══════════════════════════════════════════════════════════════════
# §4 — Auth (Firebase + JWT)
# ═══════════════════════════════════════════════════════════════════
FIREBASE_PROJECT_ID=headyme-444017
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=headyme-444017.firebaseapp.com
FIREBASE_MESSAGING_SENDER_ID=667608982461
FIREBASE_STORAGE_BUCKET=headyme-444017.firebasestorage.app
FIREBASE_APP_ID=
JWT_SECRET=
HEADY_API_KEY=
ADMIN_TOKEN=
HEADY_SESSION_JWT_SECRET=
HEADY_COOKIE_DOMAIN=.headysystems.com

# ═══════════════════════════════════════════════════════════════════
# §5 — AI Providers
# ═══════════════════════════════════════════════════════════════════
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
GROQ_API_KEY=
PERPLEXITY_API_KEY=
HF_TOKEN=
DEEPSEEK_API_KEY=

# ═══════════════════════════════════════════════════════════════════
# §6 — GCloud + Vertex AI
# ═══════════════════════════════════════════════════════════════════
GCP_PROJECT_ID=headyme-444017
GCP_PROJECT_NUMBER=667608982461
GCP_REGION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=
VERTEX_AI_LOCATION=us-central1
GCP_SECONDARY_PROJECT_ID=gen-lang-client-0920560496

# ═══════════════════════════════════════════════════════════════════
# §7 — Cloudflare
# ═══════════════════════════════════════════════════════════════════
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_ZONE_ID=

# ═══════════════════════════════════════════════════════════════════
# §8 — GitHub
# ═══════════════════════════════════════════════════════════════════
GITHUB_TOKEN=
GITHUB_ORG=HeadyMe
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
# GitHub PATs (per-org fine-grained tokens recommended)
GITHUB_PAT_HEADYME=
GITHUB_PAT_HEADYCONNECTION=
GITHUB_PAT_HEADYAI=
GITHUB_PAT_DEPLOY=

# ═══════════════════════════════════════════════════════════════════
# §9 — Azure DevOps
# ═══════════════════════════════════════════════════════════════════
AZURE_DEVOPS_PAT=
AZURE_DEVOPS_ORG=Heady-AI
AZURE_DEVOPS_PROJECT=Heady
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=

# ═══════════════════════════════════════════════════════════════════
# §10 — Sentry (Error Tracking)
# ═══════════════════════════════════════════════════════════════════
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=heady-ai
SENTRY_PROJECT=heady-production
# Webhook secret for Sentry → Linear bridge (generate with: openssl rand -hex 32)
SENTRY_WEBHOOK_SECRET=

# §10a — Linear (Project Management)
# ═══════════════════════════════════════════════════════════════════
# API key for Linear → Sentry auto-issue creation
LINEAR_API_KEY=
# Team ID for auto-created issues (find in Linear Settings → API)
LINEAR_TEAM_ID=
# Webhook secret for Linear → Sentry bridge (generate with: openssl rand -hex 32)
LINEAR_WEBHOOK_SECRET=

# ═══════════════════════════════════════════════════════════════════
# §11 — Stripe (Payments)
# ═══════════════════════════════════════════════════════════════════
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ═══════════════════════════════════════════════════════════════════
# §12 — Render (Secondary Hosting)
# ═══════════════════════════════════════════════════════════════════
RENDER_API_KEY=
RENDER_SERVICE_ID=

# ═══════════════════════════════════════════════════════════════════
# §13 — Discord
# ═══════════════════════════════════════════════════════════════════
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_TOKEN=
DISCORD_GUILD_ID=

# ═══════════════════════════════════════════════════════════════════
# §14 — Slack
# ═══════════════════════════════════════════════════════════════════
