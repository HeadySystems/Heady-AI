{
  "operation": "add-component",
  "registryVersion": "3.2.0",
  "patchVersion": "1.0.0",
  "appliedAt": "2026-04-01",
  "component": {
    "id": "context7-mcp",
    "name": "Context7DocumentationServer",
    "type": "mcp-external",
    "version": "1.0.0",
    "sourceOfTruth": "src/mcp/context7-adapter.js",
    "endpoint": "https://mcp.context7.com/mcp",
    "internalService": "http://localhost:3371",
    "responsibilities": [
      "libraryDocumentation",
      "apiReference",
      "codeExamples",
      "versionSpecificDocs"
