{
  "name": "@heady/midi-bus",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Heady internal MIDI-style messaging — compact typed frames (note/control/program/clock/SysEx) over a swappable transport (in-process + event-bus now; UDP/QUIC a drop-in adapter later).",
