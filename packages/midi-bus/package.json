  "exports": {
    ".": "./src/index.mjs",
    "./codec": "./src/codec.mjs",
    "./transport": "./src/transport.mjs"
  },
  "scripts": {
    "build": "echo \"(no build — runnable ESM)\"",
    "test": "node --test",
    "lint": "echo \"(lint wired at repo level)\""
  },
  "dependencies": { "@heady/events": "workspace:*" },
  "keywords": ["heady", "midi", "messaging", "event-bus", "transport", "sysex", "data-injection"]
}
