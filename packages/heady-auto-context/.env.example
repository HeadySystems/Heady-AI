# ═══════════════════════════════════════════════════════════
# HEADY™ AUTO-CONTEXT SERVICE — Environment Variables
# © 2026 HeadySystems Inc. — Eric Haywood, Founder
# ═══════════════════════════════════════════════════════════

# ── Service ───────────────────────────────────────────────
AUTOCONTEXT_PORT=8907
SERVICE_NAME=heady-auto-context

# ── Database (REQUIRED) ──────────────────────────────────
NEON_DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/heady?sslmode=require

# ── Embeddings (REQUIRED — at least HF_TOKEN_1) ─────────
HF_TOKEN_1=hf_xxx
HF_TOKEN_2=hf_xxx
HF_TOKEN_3=hf_xxx
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_DIM=384

# ── Redis (Optional — T0 session state) ─────────────────
UPSTASH_REDIS_URL=https://us1-xxx.upstash.io
UPSTASH_REDIS_TOKEN=xxx

# ── Pass 1 Scanner ───────────────────────────────────────
AUTOCONTEXT_SCAN_INTERVAL_MS=21000

# ── CSL Gate Overrides (phi-derived defaults) ────────────
# CSL_GATE_VOID=0.382
# CSL_GATE_RECALL=0.382
# CSL_GATE_INCLUDE=0.618
# CSL_GATE_CORE=0.718
# CSL_GATE_INJECT=0.786

# ── CORS ─────────────────────────────────────────────────
ALLOWED_ORIGINS=https://headyme.com,https://headysystems.com,https://headyconnection.org,https://headybuddy.org,https://headymcp.com,https://headyio.com,https://headybot.com,https://headyapi.com,https://headyai.com

# ── AutoContext URL (for remote middleware usage) ────────
# AUTOCONTEXT_URL=https://heady-auto-context-xxx.a.run.app
