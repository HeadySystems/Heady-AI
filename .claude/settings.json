{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "autoCompactEnabled": true,
  "autoCompactWindow": 1000000,
  "effortLevel": "xhigh",
  "alwaysThinkingEnabled": true,
  "showThinkingSummaries": true,
  "fileCheckpointingEnabled": true,
  "todoFeatureEnabled": true,
  "cleanupPeriodDays": 90,
  "enableAllProjectMcpServers": true,
  "env": {
    "ANTHROPIC_BETAS": "context-1m-2025-08-07",
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "64000",
    "MAX_THINKING_TOKENS": "32000",
    "MAX_MCP_OUTPUT_TOKENS": "50000",
    "BASH_MAX_OUTPUT_LENGTH": "120000",
    "BASH_DEFAULT_TIMEOUT_MS": "120000",
    "BASH_MAX_TIMEOUT_MS": "600000"
  },
  "permissions": {
    "allow": [
      "Read(//home/headyme/Heady-AI/**)",
      "Bash(pnpm:*)",
      "Bash(pnpm turbo:*)",
      "Bash(pnpm vitest:*)",
      "Bash(pnpm eslint:*)",
      "Bash(pnpm tsc:*)",
      "Bash(pnpm prettier:*)",
      "Bash(node --test:*)",
      "Bash(node -e:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(rg:*)",
      "Bash(grep:*)",
      "Bash(ls:*)",
      "Bash(find:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.dev.vars)",
      "Read(**/*.pem)",
      "Read(**/id_rsa*)",
      "Read(**/*.key)",
      "Read(**/secrets/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/heady-session-context.mjs\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/heady-rules.mjs\""
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/skeleton-guard-hook.mjs\""
          }
        ]
      }
    ]
  }
}
