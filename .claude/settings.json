{
  "$schema": "https://json-schema.org/draft/2020-12/schema",

  "autoCompactEnabled": true,
  "autoCompactWindow": 1000000,

  "effortLevel": "xhigh",
  "alwaysThinkingEnabled": true,
  "showThinkingSummaries": true,

  "fileCheckpointingEnabled": true,
  "todoFeatureEnabled": true,
  "cleanupPeriodDays": 90,
  "skillListingBudgetFraction": 0.02,

  "env": {
    "ANTHROPIC_BETAS": "context-1m-2025-08-07",
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "64000",
    "MAX_THINKING_TOKENS": "32000",
    "MAX_MCP_OUTPUT_TOKENS": "50000",
    "BASH_MAX_OUTPUT_LENGTH": "120000",
    "BASH_MAX_TIMEOUT_MS": "600000",
    "BASH_DEFAULT_TIMEOUT_MS": "120000"
  },

  "enableAllProjectMcpServers": true,

  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Agent",
      "Edit",
      "Write",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git checkout*)",
      "Bash(git switch*)",
      "Bash(git add*)",
      "Bash(git restore*)",
      "Bash(git stash*)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(git commit*)",
      "Bash(git rev-parse*)",
      "Bash(git grep*)",
      "Bash(git remote -v)",
      "Bash(npm run*)",
      "Bash(npm test*)",
      "Bash(npm ci*)",
      "Bash(npm install*)",
      "Bash(npm start*)",
      "Bash(npm audit*)",
      "Bash(pnpm *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(python3 *)",
      "Bash(pytest*)",
      "Bash(jest*)",
      "Bash(jq *)",
      "Bash(rg *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(gitleaks *)"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf .*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard origin*)",
      "Bash(git clean -fdx*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.heady/**)",
      "Read(**/*.pem)",
      "Read(**/id_rsa*)",
      "Read(**/*.key)",
      "Edit(**/.env)",
      "Edit(**/.env.*)"
    ],
    "ask": [
      "Bash(gcloud *delete*)",
      "Bash(*DROP TABLE*)",
      "Bash(*DROP DATABASE*)",
      "Bash(gh repo delete*)",
      "Bash(wrangler * delete*)"
    ]
  },

  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/session-context.sh",
            "timeout": 20,
            "statusMessage": "Loading Heady ecosystem context"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/guard-bash.sh",
            "timeout": 10,
            "statusMessage": "Screening for destructive commands"
          }
        ]
      }
    ]
  },

  "agentDefinitions": {
    "heady-orchestrator": {
      "path": ".claude/agents/heady-orchestrator.md",
      "description": "HCFullPipeline Orchestrator-Conductor — primary system orchestrator for pipeline execution, task routing, checkpoint protocol, and self-critique. Use for complex multi-step operations that span multiple pipeline stages."
    },
    "heady-builder": {
      "path": ".claude/agents/heady-builder.md",
      "description": "Builder agent — handles build operations, deployment, testing, lint enforcement, and CI/CD. Use when building, testing, or deploying code."
    },
    "heady-auditor": {
      "path": ".claude/agents/heady-auditor.md",
      "description": "Auditor agent — security scanning, brand compliance, code quality, dependency auditing, and governance enforcement. Use for security reviews and compliance checks."
    },
    "heady-researcher": {
      "path": ".claude/agents/heady-researcher.md",
      "description": "Researcher agent — knowledge ingestion, concept extraction, trend analysis, public domain pattern mining. Use before building to research best practices."
    },
    "heady-observer": {
      "path": ".claude/agents/heady-observer.md",
      "description": "Observer agent — health checks, metrics collection, alert evaluation, readiness probing. Use for system monitoring and health assessment."
    },
    "heady-deployer": {
      "path": ".claude/agents/heady-deployer.md",
      "description": "Deployer agent — infrastructure deployment, environment sync, Render/Docker/Cloudflare operations. Use for deployment and infrastructure tasks."
    },
    "heady-liquid-brain": {
      "path": ".claude/agents/heady-liquid-brain.md",
      "description": "Liquid Latent OS Brain agent — meta-controller operating BUDDY_KERNEL.md, HeadyMemory consolidation, AutoContext enrichment, CSL gate decisions, and φ-scaled self-awareness. Use for system intelligence, memory operations, and cognitive architecture tasks."
    }
  }
}
