{
  "name": "Heady MCP Server",
  "version": "1.0.0",
  "description": "Heady™ Latent OS — orchestration, memory, and multi-agent tooling via the Model Context Protocol. Served by src/heady-mcp-server.js.",
  "homepage": "https://headysystems.com",
  "documentation": "https://docs.headysystems.com",
  "transport": {
    "type": "streamable-http",
    "endpoint": "/mcp/v1",
    "fallback": "sse"
  },
  "authentication": {
    "schemes": ["bearer", "dpop"],
    "spec_version": "2025-06-18",
    "oauth": {
      "version": "2.1",
      "authorization_url": "https://auth.headysystems.com/authorize",
      "token_url": "https://auth.headysystems.com/token",
      "registration_url": "https://auth.headysystems.com/register",
      "scopes": ["read", "write", "admin", "agent:execute", "tool:invoke"],
      "resource_indicators": true,
      "pkce_required": true,
      "dpop_supported": true
    }
  },
  "capabilities": {
    "tools": true,
    "resources": true,
    "prompts": true,
    "sampling": true,
    "logging": true
  },
  "tool_manifest": "configs/mcp-tools.json",
  "tools": [
    { "name": "heady_chat", "tier": 1, "category": "intelligence", "description": "Conversational entry point routed through the brain node" },
    { "name": "heady_explain", "tier": 1, "category": "intelligence", "description": "Explain code or concepts with grounded context" },
    { "name": "heady_analyze", "tier": 2, "category": "intelligence", "description": "Analyze code / data and emit structured findings" },
    { "name": "heady_architect", "tier": 2, "category": "engineering", "description": "Produce architectural plans and ADR-aligned designs" },
    { "name": "heady_coder", "tier": 2, "category": "engineering", "description": "Generate code adhering to Heady coding rules" },
    { "name": "heady_code_review", "tier": 2, "category": "engineering", "description": "Review a diff against governance + coding standards" },
    { "name": "heady_complete", "tier": 2, "category": "engineering", "description": "Complete partial implementations" },
    { "name": "heady_debug", "tier": 2, "category": "engineering", "description": "Diagnose failures using autocontext history" },
    { "name": "heady_refactor", "tier": 2, "category": "engineering", "description": "Refactor code preserving behavior" },
    { "name": "heady_write_tests", "tier": 2, "category": "engineering", "description": "Author tests alongside code" },
    { "name": "heady_deep_scan", "tier": 2, "category": "engineering", "description": "Deep scan of repo / ecosystem" },
    { "name": "heady_auto_flow", "tier": 2, "category": "orchestration", "description": "Run an auto-flow task pipeline" },
    { "name": "heady_embed", "tier": 2, "category": "memory", "description": "Gate-then-embed content into pgvector" },
    { "name": "heady_memory", "tier": 1, "category": "memory", "description": "Query 3-tier vector memory" },
    { "name": "heady_patterns", "tier": 2, "category": "resilience", "description": "Apply / inspect resilience patterns" },
    { "name": "heady_maintenance", "tier": 2, "category": "operations", "description": "Run maintenance ops" },
    { "name": "heady_soul", "tier": 1, "category": "intelligence", "description": "Reflection / self-critique query" },
    { "name": "heady_lens", "tier": 1, "category": "intelligence", "description": "Differential lens over outputs" },
    { "name": "heady_risks", "tier": 1, "category": "governance", "description": "Enumerate risks for a change" },
    { "name": "heady_battle", "tier": 1, "category": "intelligence", "description": "Multi-model battle comparison" },
    { "name": "heady_vinci", "tier": 2, "category": "creative", "description": "Creative canvas generation" },
    { "name": "heady_buddy", "tier": 2, "category": "companion", "description": "Companion agent interaction" },
    { "name": "heady_search", "tier": 1, "category": "intelligence", "description": "Semantic + hybrid search" },
    { "name": "heady_edge_ai", "tier": 1, "category": "edge", "description": "Edge inference via Cloudflare Workers AI" },
    { "name": "heady_notion", "tier": 1, "category": "knowledge", "description": "Knowledge base query" },
    { "name": "heady_maid", "tier": 1, "category": "operations", "description": "Housekeeping / maintenance status" },
    { "name": "heady_health", "tier": 1, "category": "observability", "description": "Aggregate node/service health" },
    { "name": "heady_hcfp_status", "tier": 1, "category": "pipeline", "description": "HCFullPipeline status" },
    { "name": "heady_orchestrator", "tier": 1, "category": "orchestration", "description": "Orchestration status + dispatch preview" },
    { "name": "heady_claude", "tier": 1, "category": "provider", "description": "Anthropic Claude provider passthrough" },
    { "name": "heady_openai", "tier": 1, "category": "provider", "description": "OpenAI provider passthrough" },
    { "name": "heady_gemini", "tier": 1, "category": "provider", "description": "Google Gemini provider passthrough" },
    { "name": "heady_groq", "tier": 1, "category": "provider", "description": "Groq provider passthrough" },
    { "name": "heady_codex", "tier": 2, "category": "provider", "description": "Codex-style code provider" },
    { "name": "heady_copilot", "tier": 2, "category": "provider", "description": "Copilot-style code provider" },
    { "name": "heady_huggingface_model", "tier": 1, "category": "provider", "description": "Hugging Face model passthrough" },
    { "name": "heady_perplexity_research", "tier": 1, "category": "research", "description": "Perplexity Sonar external grounding (optional fallback)" },
    { "name": "heady_deploy", "tier": 3, "category": "operations", "description": "Deploy — HITL + trust receipt required" },
    { "name": "heady_ops", "tier": 3, "category": "operations", "description": "Operations mutations — HITL required" },
    { "name": "heady_jules_task", "tier": 3, "category": "operations", "description": "Dispatch a Jules task — HITL required" }
  ]
}
