{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "1.0.0",
  "updated": "2026-07-04",
  "authority": "Locked scaffold from rebuild branch. Expand by adding entries here \u2014 never by dropping files ad-hoc.",
  "directories": [
    {
      "pattern": "apps/*/src/**",
      "purpose": "Application source code",
      "allowedExtensions": [
        ".js",
        ".mjs",
        ".ts",
        ".jsx",
        ".tsx",
        ".css",
        ".html",
        ".svg",
        ".png",
        ".json"
      ],
      "notes": "Vite SPAs + Vanilla Web Components"
    },
    {
      "pattern": "apps/*/public/**",
      "purpose": "Static assets served at root",
      "allowedExtensions": [
        ".html",
        ".svg",
        ".png",
        ".ico",
        ".webmanifest",
        ".json"
      ],
      "notes": "Public directory for Vite apps"
    },
    {
      "pattern": "apps/*/dist/**",
      "purpose": "Build output (generated, not authored)",
      "allowedExtensions": [
        "*"
      ],
      "notes": "Excluded from authored-file audits"
    },
    {
      "pattern": "apps/*",
      "purpose": "Application root config",
      "allowedExtensions": [
        ".json",
        ".js",
        ".mjs",
        ".ts",
        ".html",
        ".yaml",
        ".yml",
        ".firebaserc"
      ],
      "notes": "package.json, vite.config, tsconfig, firebase config"
    },
    {
      "pattern": "packages/*/src/**",
      "purpose": "Shared package source code",
      "allowedExtensions": [
        ".js",
        ".mjs",
        ".ts"
      ],
      "notes": "ESM only, no CommonJS"
    },
    {
      "pattern": "packages/*/test/**",
      "purpose": "Package unit/integration tests",
      "allowedExtensions": [
        ".js",
        ".mjs",
        ".ts"
      ],
      "notes": "Vitest test files"
    },
    {
      "pattern": "packages/*/migrations/**",
      "purpose": "Database migrations",
      "allowedExtensions": [
        ".sql",
        ".mjs",
        ".js"
      ],
      "notes": "Neon pgvector migrations"
    },
    {
      "pattern": "packages/*/openapi/**",
      "purpose": "OpenAPI contract specifications",
      "allowedExtensions": [
        ".yaml",
        ".yml",
        ".json"
      ],
      "notes": "API contracts"
    },
    {
      "pattern": "packages/*",
      "purpose": "Package root config",
      "allowedExtensions": [
        ".json",
        ".js",
        ".mjs",
        ".ts",
        ".md"
      ],
      "notes": "package.json, tsconfig, README"
    },
    {
      "pattern": "tooling/*/src/**",
      "purpose": "Tooling source code",
      "allowedExtensions": [
        ".js",
        ".mjs",
        ".ts"
      ],
      "notes": "Build/CI tooling source"
    },
    {
      "pattern": "tooling/*/test/**",
      "purpose": "Tooling tests",
      "allowedExtensions": [
        ".js",
        ".mjs",
        ".ts"
      ],
      "notes": "Vitest test files for tooling"
    },
    {
      "pattern": "tooling/*/flows/**",
      "purpose": "Auto-flow declarative definitions",
      "allowedExtensions": [
        ".json",
        ".mjs"
      ],
      "notes": "Zod-validated flow definitions (JSON) and flow scripts (MJS)"
    },
    {
      "pattern": "tooling/*/.provenance/**",
      "purpose": "Data provenance tracking",
      "allowedExtensions": [
        ".json",
        ".md"
      ],
      "notes": "Provenance metadata"
    },
    {
      "pattern": "tooling/*/templates/**",
      "purpose": "Handlebars-style report/doc templates",
      "allowedExtensions": [
        ".hbs",
        ".md",
        ".json"
      ],
      "notes": "doc-hydrator + report-templates source templates"
    },
    {
      "pattern": "tooling/*/bindings/**",
      "purpose": "Report-template data-source binding scripts",
      "allowedExtensions": [
        ".mjs",
        ".js",
        ".json"
      ],
      "notes": "Each prints JSON consumed by report-templates render"
    },
    {
      "pattern": "tooling/*",
      "purpose": "Tooling root config and scripts",
      "allowedExtensions": [
        ".json",
        ".mjs",
        ".js",
        ".sh",
        ".md"
      ],
      "notes": "package.json, preflight.mjs, register.mjs, etc."
    },
    {
      "pattern": "configs/**",
      "purpose": "Shared configuration files",
      "allowedExtensions": [
        ".json",
        ".yaml",
        ".yml",
        ".js",
        ".mjs"
      ],
      "notes": "Pipeline tasks, shared config"
    },
    {
      "pattern": "docs/design/**",
      "purpose": "Design-data bundle: canon-derived tokens + briefs for Claude design tools and v0",
      "allowedExtensions": [
        ".md",
        ".json"
      ],
      "notes": "design-tokens.json is machine-readable W3C design-tokens format, derived from facts.yaml + phi-math"
    },
    {
      "pattern": "docs/**",
      "purpose": "Documentation, ADRs, specs, compendium",
      "allowedExtensions": [
        ".md"
      ],
      "notes": "Markdown only \u2014 no code in docs/"
    },
    {
      "pattern": ".agents/skills/*/**",
      "purpose": "Skill definitions and resources",
      "allowedExtensions": [
        ".md",
        ".mjs",
        ".js",
        ".json",
        ".sh"
      ],
      "notes": "SKILL.md is required per skill"
    },
    {
      "pattern": ".agents/skills/*",
      "purpose": "Skill directory root",
      "allowedExtensions": [
        ".md"
      ],
      "notes": "SKILL.md frontmatter required"
    },
    {
      "pattern": ".agents/agents/**",
      "purpose": "Agent definitions",
      "allowedExtensions": [
        ".md",
        ".json",
        ".yaml"
      ],
      "notes": "Agent persona and config definitions"
    },
    {
      "pattern": ".agents/context/**",
      "purpose": "Agent context documents and scripts",
      "allowedExtensions": [
        ".md",
        ".sh",
        ".json"
      ],
      "notes": "Super prompts, context scanners"
    },
    {
      "pattern": ".agents/personas/**",
      "purpose": "Agent persona definitions",
      "allowedExtensions": [
        ".md",
        ".json"
      ],
      "notes": "HEADY_PERSONA_*.md and SKILL.md files"
    },
    {
      "pattern": ".agents/workflows/**",
      "purpose": "Workflow definitions",
      "allowedExtensions": [
        ".md"
      ],
      "notes": "Markdown workflow files"
    },
    {
      "pattern": ".claude/skills/**/scripts/**",
      "purpose": "Claude skill helper scripts",
      "allowedExtensions": [
        ".js",
        ".mjs",
        ".sh"
      ],
      "notes": "Helper scripts for skills (e.g., perplexity-connector.js)"
    },
    {
      "pattern": ".claude/skills/**",
      "purpose": "Claude Code registered skill mirrors",
      "allowedExtensions": [
        ".md",
        ".js",
        ".mjs"
      ],
      "notes": "Lifted from .agents/skills via register.mjs"
    },
    {
      "pattern": ".claude/hooks/**",
      "purpose": "Claude Code PreToolUse/PostToolUse hooks",
      "allowedExtensions": [
        ".mjs",
        ".js"
      ],
      "notes": "Rule enforcement gates"
    },
    {
      "pattern": ".claude/commands/**",
      "purpose": "Claude Code custom commands",
      "allowedExtensions": [
        ".md",
        ".json"
      ],
      "notes": "Slash command definitions"
    },
    {
      "pattern": ".claude/agents/**",
      "purpose": "Claude Code agent definitions",
      "allowedExtensions": [
        ".md",
        ".json",
        ".yaml",
        ".yml"
      ],
      "notes": "Agent configuration"
    },
    {
      "pattern": ".claude",
      "purpose": "Claude Code integration root",
      "allowedExtensions": [
        ".json",
        ".md"
      ],
      "notes": "settings.json, CLAUDE.md"
    },
    {
      "pattern": ".github/**",
      "purpose": "GitHub Actions CI/CD workflows + repo config",
      "allowedExtensions": [
        ".yml",
        ".yaml",
        ".md",
        ".json"
      ],
      "notes": "CI (coherence gate), CODEOWNERS, issue templates"
    },
    {
      "pattern": "scripts/**",
      "purpose": "Operational shell/JS scripts",
      "allowedExtensions": [
        ".sh",
        ".mjs",
        ".js"
      ],
      "notes": "heady-sync.sh (git sync w/ secret guard), ops scripts"
    },
    {
      "pattern": ".data/**",
      "purpose": "Runtime/agent data stores",
      "allowedExtensions": [
        ".json",
        ".jsonl",
        ".cache",
        ".bin"
      ],
      "notes": "Agent-managed data; no hand-authored files"
    },
    {
      "pattern": "scratch/**",
      "purpose": "Temporary scratch files",
      "allowedExtensions": [
        "*"
      ],
      "notes": "Exempt from strict placement rules \u2014 any file type allowed"
    },
    {
      "pattern": "heady-commander-plugin/**",
      "purpose": "Heady Commander plugin",
      "allowedExtensions": [
        ".json",
        ".md",
        ".mjs",
        ".js",
        ".plugin",
        ".yaml",
        ".yml"
      ],
      "notes": "Plugin package"
    },
    {
      "pattern": "src/**",
      "purpose": "LEGACY manager tree (pre-rebuild) \u2014 maintenance and security hardening only",
      "allowedExtensions": [
        ".js",
        ".mjs",
        ".json"
      ],
      "notes": "SEC-002 remediation surface. New modules belong in packages/* \u2014 do not grow this tree; port out of it (REBUILD_PLAN_V2 port-and-verify)."
    }
  ],
  "rootFiles": [
    "package.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "turbo.json",
    "AGENTS.md",
    "CLAUDE.md",
    "CLAUDE_MEMORY.md",
    "CLAUDE_PROJECT_INSTRUCTIONS.md",
    "SOURCE_OF_TRUTH.md",
    "facts.yaml",
    "lexicon.yaml",
    ".dockerignore",
    "Dockerfile",
    "claude_desktop_config.json",
    "heady-latent-os-commander.plugin",
    "scaffold_heady.sh",
    ".gitignore",
    ".env.example",
    ".env",
    ".npmrc",
    ".nvmrc",
    ".node-version",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "CONTRIBUTING.md"
  ],
  "rootDirectories": [
    "apps",
    "packages",
    "tooling",
    "configs",
    "docs",
    "scripts",
    "scratch",
    ".agents",
    ".claude",
    ".github",
    ".data",
    "heady-commander-plugin",
    "node_modules",
    ".git",
    ".turbo",
    ".firebase",
    "src"
  ],
  "antiPatterns": [
    {
      "id": "no-root-source",
      "description": "No source files at repo root",
      "pattern": "^[^/]+\\.(mjs|js|ts|jsx|tsx)$",
      "except": [
        "scaffold_heady.sh"
      ],
      "message": "Source files must live in apps/*/src/, packages/*/src/, or tooling/*/. Move this file to the appropriate source tree."
    },
    {
      "id": "no-stray-package-json",
      "description": "package.json only in recognized package roots",
      "pattern": "^(?!(?:apps|packages|tooling|heady-commander-plugin)/[^/]+/package\\.json$)(?!package\\.json$).*/package\\.json$",
      "except": [],
      "message": "package.json files belong at repo root or inside apps/*/,  packages/*/, tooling/*/, or heady-commander-plugin/. Do not nest package.json in subdirectories."
    },
    {
      "id": "no-docs-in-src",
      "description": "No .md documentation inside source directories",
      "pattern": "(?:apps|packages|tooling)/[^/]+/src/.*\\.md$",
      "except": [],
      "message": "Documentation (.md) should not live inside src/ directories. Move to docs/ or the package root."
    },
    {
      "id": "no-tests-outside-test-dirs",
      "description": "Test files must use .test. or .spec. naming, or live in test/ directories",
      "pattern": "(?:apps|packages|tooling)/[^/]+/src/.*\\.(test|spec)\\.(js|mjs|ts)$",
      "except": [],
      "message": "Test files should live in test/ or __tests__/ directories, not inside src/."
    }
  ],
  "exclude": [
    "node_modules",
    ".git",
    ".turbo",
    "dist",
    ".firebase",
    "pnpm-lock.yaml"
  ]
}