FROM node:22-alpine

LABEL service="heady-buddy-api" \
      version="2.1.0" \
      sacred_geometry_layer="Middle"

WORKDIR /app

COPY package.json ./
RUN npm install --production

COPY . .

ENV PORT=3002
EXPOSE 3002

RUN addgroup -g 1001 -S heady && \
    adduser -S heady -u 1001 -G heady
USER heady

CMD ["node", "server.js"]
