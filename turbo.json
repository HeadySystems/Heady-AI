{  
  "$schema": "https://turbo.build/schema.json",  
  "daemon": false,
  "tasks": {  
    "build": {  
      "dependsOn": ["^build"],  
      "outputs": ["dist/**", ".next/**", "build/**"],  
      "cache": true  
    },  
    "dev": {  
      "cache": false,  
      "persistent": true  
    },  
    "lint": {  
      "dependsOn": ["^build"],  
      "outputs": [],  
      "cache": true  
    },  
    "test": {  
      "dependsOn": ["^build"],  
      "outputs": ["coverage/**"],  
      "cache": true  
    },  
    "security:scan": {  
      "cache": false,  
      "outputs": []  
    },  
    "clean": {  
      "cache": false,  
      "outputs": []  
    }  
  },  
  "ui": "stream"  
}
