{
  "servers": {
    "heady-cloud": {
      "type": "http",
      "url": "https://headymcp.com/mcp",
      "headers": {
        "Authorization": "Bearer YOUR_HEADY_API_KEY"
      }
    },
    "heady-local": {
      "type": "stdio",
      "command": "node",
      "args": ["/home/headyme/Heady/services/heady-mcp-server/src/index.js"],
      "env": {
        "HEADY_MCP_TRANSPORT": "stdio",
        "NODE_ENV": "development"
      }
    },
    "heady-codebase": {
      "type": "stdio",
      "command": "node",
      "args": ["/home/headyme/Heady/src/mcp/heady-mcp-server.js"],
      "env": {
        "HEADY_WORKSPACE_ROOT": "/home/headyme/Heady",
        "NODE_ENV": "development"
      }
    }
  }
}
