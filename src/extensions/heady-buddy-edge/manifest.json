{
  "manifest_version": 3,
  "name": "HeadyBuddy™ Edge",
  "version": "1.0.0",
  "description": "Sovereign Node Management for Heady™ Systems",
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "storage",
    "notifications"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon48.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
