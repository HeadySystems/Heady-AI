    "tar": ">=6.2.1",
    "js-yaml": "^4.1.1",
    "minimatch": ">=3.0.5",
    "slug": ">=9.1.0"
  },
  "pnpm": {
    "overrides": {
      "@hono/node-server": ">=1.19.10",
      "@tootallnate/once": ">=3.0.1",
      "body-parser": ">=1.20.3",
      "brace-expansion": ">=5.0.5",
      "braces": ">=3.0.3",
      "cookie": ">=0.7.0",
      "cross-spawn": ">=7.0.5",
      "dompurify": ">=3.3.2",
      "effect": ">=3.20.0",
      "esbuild": ">=0.25.0",
      "express": ">=4.21.2",
      "fast-xml-parser": ">=4.5.1",
      "fastify": ">=5.8.3",
      "flatted": "^3.4.2",
      "handlebars": ">=4.7.9",
      "hono": ">=4.11.10",
      "ip": ">=2.0.1",
      "js-yaml": ">=3.13.1",
      "langsmith": ">=0.4.6",
      "lodash": ">=4.18.0",
      "micromatch": ">=4.0.8",
      "minimatch": ">=9.0.7",
      "nanoid": ">=3.3.8",
      "node-forge": ">=1.4.0",
      "nodemailer": ">=8.0.4",
      "path-to-regexp": ">=8.4.0",
      "picomatch": ">=4.0.4",
      "postcss": ">=8.4.31",
      "protobufjs": ">=7.4.0",
      "semver": ">=7.5.4",
      "send": ">=0.19.1",
      "serve-static": ">=1.16.2",
      "slug": ">=9.1.0",
      "tar": ">=6.2.1",
      "underscore": ">=1.13.7",
