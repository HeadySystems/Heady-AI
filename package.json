{
  "name": "heady-latent-os",
  "version": "5.0.0",
  "description": "Self-aware, self-correcting intelligence infrastructure \u2014 the Heady Latent OS",
  "main": "heady-manager.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "start": "node heady-manager.js",
    "start:mcp": "node backend/app.js",
    "dev": "node --watch heady-manager.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ --ext .js,.mjs",
    "lint:fix": "eslint src/ --ext .js,.mjs --fix",
    "build:frontend": "cd frontend && vite build",
    "build": "pnpm --filter heady-admin-ui build",
    "frontend": "npm run dev --prefix frontend",
    "backend": "npm start --prefix backend",
    "docker:build": "podman build -t heady:latest .",
    "docker:run": "podman run -d -p 3301:3301 -v heady-data:/app/data heady:latest",
    "health": "curl -s https://heady.headysystems.com/health | jq",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "deploy": "node scripts/deploy.js",
    "deploy:auto": "node scripts/deploy.js --auto",
    "brand:check": "node scripts/brand_headers.js --check",
    "brand:fix": "node scripts/brand_headers.js --fix",
    "test:domains": "node scripts/domain-connectivity-test.js",
    "test:branding": "node scripts/validate-branding.js",
    "audit:fix": "npm audit fix --force",
    "cli": "python scripts/heady_cli.py",
    "validate:env": "node src/security/env-validator.cjs",
    "validate:env:strict": "node src/security/env-validator.cjs --strict",
    "validate:env:ci": "node src/security/env-validator.cjs --ci",
    "predeploy": "node src/security/env-validator.cjs --strict",
    "prepare": "husky install"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.82.0",
    "@google/genai": "^1.48.0",
    "@google/generative-ai": "^0.24.1",
    "@heady-ai/phi-math": "file:./packages/phi-math",
    "@heady-ai/structured-logger": "file:./packages/structured-logger",
    "@huggingface/inference": "^4.13.12",
    "@langchain/core": "^1.1.38",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@notionhq/client": "^2.2.15",
    "@octokit/auth-app": "^8.2.0",
    "axios": "^1.14.0",
    "bcrypt": "^6.0.0",
    "commander": "^14.0.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.0",
    "eventsource": "^3.0.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.3.2",
    "rate-limit-redis": "^4.2.0",
    "groq-sdk": "^0.37.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.4.1",
    "js-yaml": "^4.1.1",
    "jsonwebtoken": "^9.0.3",
    "langchain": "^1.2.35",
    "node-cron": "^3.0.2",
    "ollama": "^0.5.11",
    "openai": "^4.68.0",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "replace-in-file": "^8.4.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^13.0.0",
    "winston": "^3.19.0",
    "ws": "^8.20.0",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "concurrently": "^9.1.2",
    "eslint": "^10.0.3",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "nodemon": "^3.1.9",
    "prettier": "^3.3.3",
    "supertest": "^7.2.2",
    "vitest": "^4.1.2"
  },
  "offline": {
    "nodeModulesPath": "./offline-packages/node_modules",
    "pythonPackagesPath": "./offline-packages/python-libs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/HeadyMe/Heady-8f71ffc8.git"
  },
  "author": "HeadySystems Inc.",
  "license": "UNLICENSED",
  "overrides": {
    "flatted": "^3.4.2",
    "protobufjs": ">=7.4.0",
