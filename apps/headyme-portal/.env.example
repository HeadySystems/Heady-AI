# ╔══════════════════════════════════════════════════════════════════╗
# ║  HEADY™ Portal Environment Variables                              ║
# ║  Copy to .env.local for dev; set as Cloud Run env vars in prod.   ║
# ║  NEVER commit .env.local — it is gitignored.                      ║
# ╚══════════════════════════════════════════════════════════════════╝

# ── Rebuild Codeflow API ────────────────────────────────────────────
# Firebase-verifying portal gateway. Never point browser builds directly at the
# private Cloud Run origin. Omit this value on headyme.com for same-origin /api/*.
VITE_CODEFLOW_API=https://headyme.com

# ── Legacy Advisor API ──────────────────────────────────────────────
# heady-production Cloud Run service (HeadyAI/heady-production)
# Get from: gcloud run services describe heady-production --region=us-central1 --format='value(status.url)'
VITE_LEGACY_API=https://heady-production-XXXX-uc.a.run.app

# ── HeadyLens Stream ────────────────────────────────────────────────
# For the Build Narrative panel in #admin (SSE stream from HeadyLens)
VITE_HEADYLENS_API=https://heady-lens-XXXX-uc.a.run.app

# ── Firebase Config ─────────────────────────────────────────────────
# From Firebase Console → Project Settings → Your apps → SDK snippet
# These are already baked into src/services/firebase.js from PR #207.
# Override here only if pointing at a different Firebase project.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
