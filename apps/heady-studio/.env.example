# ╔══════════════════════════════════════════════════════════════════╗
# ║  HEADY™ Studio (SPA) — Vite env template                          ║
# ║  Only VITE_* vars are exposed to the browser bundle.               ║
# ╚══════════════════════════════════════════════════════════════════╝
# Canonical Heady MCP gateway. The SPA composes ${VITE_GATEWAY_URL}/mcp and
# ${VITE_GATEWAY_URL}/api/studio/* from this single origin.
VITE_GATEWAY_URL=https://headymcp.com

# Firebase web config (public by design; override per environment).
VITE_FIREBASE_PROJECT_ID=heady-ai
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=heady-ai.firebaseapp.com
VITE_FIREBASE_APP_ID=
