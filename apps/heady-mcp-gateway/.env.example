# ╔══════════════════════════════════════════════════════════════════╗
# ║  HEADY™ MCP Gateway — environment template                        ║
# ║  Secrets resolve from GCP Secret Manager in production (no plaintext)║
# ╚══════════════════════════════════════════════════════════════════╝
# Cloud Run injects PORT automatically; default 8080 for local container runs.
PORT=8080
HEADY_SERVICE=heady-mcp-gateway

# Firebase project whose ID tokens this gateway accepts (fail-closed if unset).
FIREBASE_PROJECT_ID=heady-ai

# Exact browser origins permitted (comma-separated). No wildcards with credentials.
ALLOWED_ORIGINS=https://studio.headymcp.com,https://headymcp.com

# Neon Postgres + pgvector — persistent-memory authority. [SECRET]
# When unset, memory tools return bound:false (no fabricated rows).
DATABASE_URL=

# External MCP server endpoints (Streamable-HTTP, conventionally /mcp). [SECRET where tokened]
MCP_GITHUB_URL=
MCP_SLACK_URL=
MCP_LINEAR_URL=
MCP_SENTRY_URL=
MCP_STRIPE_URL=
