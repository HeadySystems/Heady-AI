# ═══════════════════════════════════════════════════════════════
# Heady™ .gcloudignore
# Excludes non-essential files from Cloud Run source deploy.
# Keeps container small and deploy fast.
# ═══════════════════════════════════════════════════════════════

# Respect .gitignore
#!include:.gitignore

# ── Re-include workspace packages the .gitignore credential globs swallow ──
# .gitignore:19 `**/*secret*` and :33 `**/secrets/` are defense-in-depth against
# committing credential FILES. They also match `packages/secrets/` — the package
# that RESOLVES secrets and holds none. Git exempts it because it is already
# tracked; gcloud applies the pattern regardless, so every Cloud Build upload
# silently dropped it and `apps/approval-api/Dockerfile` failed at
# `COPY packages/secrets/package.json` with "file not found in build context".
# Negate the directory itself, not just its contents — a gitignore-style
# exclusion of a parent directory cannot be undone from inside it.
!packages/secrets/
!packages/secrets/**

# Credentials and local secret material
.env
.env.*
!.env.example
**/*.credentials
**/credentials.json
**/*-credentials.json
**/service-account.json
*.key
*.pem
*.p12
*.pfx
*.jwk

# Git
.git/
.github/

# Archive (dead weight — logic is embedded in the registry)
_archive/

# IDE/Editor
.vscode/
.idea/
*.swp
*.swo

# Dev tooling
.eslintrc*
.prettierrc*
jest.config.*
tsconfig.*

# Docs we don't need at runtime (strategic docs)
docs/strategic/
docs/patents/
docs/investor/

# Tests
__tests__/
**/*.test.js
**/*.spec.js
**/*.test.mjs
**/*.spec.mjs
coverage/

# Build artifacts
*.map
*.log

# Large unnecessary directories
node_modules/
.data/
tmp/
cloudflare-workers/
src/landing/

# Agents/skills/workflows (IDE-only)
.agents/
.agent/
_agents/
_agent/

# Gemini brain (local only)
.gemini/
